<Window x:Class="Calculadora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculadora"
        mc:Ignorable="d"
        Title="Calculadora" Height="650" Width="450">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition />
             <RowDefinition />
              <RowDefinition />
               <RowDefinition />
                <RowDefinition />
                 <RowDefinition />

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition /> 
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>

        </Grid.ColumnDefinitions>


        <StackPanel  Grid.Row="0" Grid.Column="0" Margin ="0 0 5 0" Grid.ColumnSpan="5" >
            <Label Name="Historial" Content="↻" />
             <Label Name="Resultado" Content="14"/>

        </StackPanel>

        <Button Grid.Row="1" Grid.Column="0" Margin ="0 0 5 0" FontSize="30" Content="√ " Click="PresionarBoton" />
        <Button Grid.Row="3" Grid.Column="0" Margin ="0 0 5 0" FontSize="30" Content="x^" Click="PresionarBoton" />
        <Button Grid.Row="5" Grid.Column="0" Margin ="0 0 5 0" FontSize="30" Content="log" Click="PresionarBoton" />

        <Button   Grid.Row="1" Grid.Column="1" Margin ="0 0 5 0" FontSize="30" Content="(" Click="PresionarBoton" />
        <Button Grid.Row="1" Grid.Column="2"  Margin ="0 0 5 0" FontSize="30" Content=")" Click="PresionarBoton" />
         <Button Grid.Row="1" Grid.Column="3"  Margin ="0 0 5 0" FontSize="30" Content="%" Click="PresionarBoton" />
          <Button Grid.Row="1" Grid.Column="4"  Margin ="0 0 5 0" FontSize="30" Content="AC" Click="PresionarBoton" />

        <Button Grid.Row="2" Grid.Column="1" Margin ="0 0 5 0" FontSize="30" Content="7" Click="PresionarBoton" />
        <Button Grid.Row="2" Grid.Column="2"  Margin ="0 0 5 0" FontSize="30" Content="8" Click="PresionarBoton" />
         <Button Grid.Row="2" Grid.Column="3" Margin ="0 0 5 0" FontSize="30" Content="9" Click="PresionarBoton" />
          <Button Grid.Row="2" Grid.Column="4" Margin ="0 0 5 0" FontSize="30" Content="÷" Click="PresionarBoton" />

        <Button Grid.Row="3" Grid.Column="1" Margin ="0 0 5 0" FontSize="30" Content="4" Click="PresionarBoton" />
        <Button Grid.Row="3" Grid.Column="2" Margin ="0 0 5 0" FontSize="30" Content="5" Click="PresionarBoton" />
         <Button Grid.Row="3" Grid.Column="3" Margin ="0 0 5 0" FontSize="30" Content="6" Click="PresionarBoton" />
          <Button Grid.Row="3" Grid.Column="4" Margin ="0 0 5 0" FontSize="30" Content="×" Click="PresionarBoton" />

          <Button Grid.Row="4" Grid.Column="1" Margin ="0 0 5 0" FontSize="30" Content="1" Click="PresionarBoton"  />
        <Button Grid.Row="4" Grid.Column="2"  Margin ="0 0 5 0" FontSize="30" Content="2" Click="PresionarBoton" />
         <Button Grid.Row="4" Grid.Column="3" Margin ="0 0 5 0" FontSize="30" Content="3" Click="PresionarBoton" />
          <Button Grid.Row="4" Grid.Column="4" Margin ="0 0 5 0" FontSize="30" Content="-" Click="PresionarBoton" />

          <Button Grid.Row="5" Grid.Column="1" Margin ="0 0 5 0" FontSize="30" Content="0" Click="PresionarBoton" />
        <Button Grid.Row="5" Grid.Column="2" Margin ="0 0 5 0" FontSize="30" Content="." Click="PresionarBoton" />
         <Button Grid.Row="5" Grid.Column="3" Margin ="0 0 5 0" FontSize="30" Content="=" Click="PresionarBoton" />
          <Button Grid.Row="5" Grid.Column="4" Margin ="0 0 5 0" FontSize="30" Content="+" Click="PresionarBoton" />

           
    </Grid>

</Window>
